PORT=3001
REDIS_PASSWORD=replace-with-a-long-url-safe-random-password
REDIS_URL=redis://blinddrop:replace-with-a-long-url-safe-random-password@localhost:6379
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=blinddrop.atas.tech
TURNSTILE_ACTION=create-secret
CORS_ORIGIN=https://blinddrop.atas.tech
TRUSTED_PROXY_IPS=
CREATE_RATE_LIMIT_MAX=100
META_RATE_LIMIT_MAX=300
REVEAL_RATE_LIMIT_MAX=100
BURN_RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=3600000
STATUS_TTL_SECONDS=3600
NODE_ENV=production

# Frontend build variables. Local development may explicitly opt into HTTP
# and the test Turnstile bypass; production builds must not set either flag.
VITE_API_URL=https://blinddrop-api.atas.tech
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ACTION=create-secret
